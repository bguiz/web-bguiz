---
import roles from '../data/roles.json';
---

<section class="credentials-section">
  <h2 class="section-title">Track Record <span class="text-neon-green">// Technical Credentials</span></h2>
  
  <div class="timeline">
    {roles.map((role) => (
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <span class="timeline-year">{role.year}</span>
          <h3>{role.role} @ <span class="text-neon-purple">{role.company}</span></h3>
          <p>{role.achievement}</p>
        </div>
      </div>
    ))}
  </div>
  
  <div class="metrics-grid">
    <div class="metric">
      <span class="metric-value text-neon-green">1m+</span>
      <span class="metric-label">User Systems</span>
    </div>
    <div class="metric">
      <span class="metric-value text-neon-purple">17</span>
      <span class="metric-label">Years Experience</span>
    </div>
    <div class="metric">
      <span class="metric-value text-neon-green">1000s</span>
      <span class="metric-label">Students Taught</span>
    </div>
  </div>
  
  <div class="cta-container">
    <a href="https://www.linkedin.com/in/brendangraetz/" target="_blank" download class="btn-neon">View full resume (LinkedIn)</a>
  </div>
</section>

<style>
  .credentials-section { padding: 4rem 2rem; max-width: 1000px; margin: 0 auto; }
  
  .timeline {
    position: relative;
    padding-left: 2rem;
    border-left: 2px solid #333;
    margin: 3rem 0;
  }
  
  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
    padding-left: 2rem;
  }
  
  .timeline-marker {
    position: absolute;
    left: -2.6rem;
    top: 0;
    width: 1rem;
    height: 1rem;
    background: var(--neon-purple);
    border-radius: 50%;
    border: 3px solid var(--bg-dark);
  }
  
  .timeline-year {
    font-size: 0.875rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  
  .timeline-content h3 { margin: 0.5rem 0; font-size: 1.5rem; }
  .timeline-content p { color: var(--text-muted); }
  
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 2rem;
    margin: 3rem 0;
    text-align: center;
  }
  
  .metric-value { font-size: 3rem; font-weight: bold; display: block; }
  .metric-label { color: var(--text-muted); font-size: 0.875rem; text-transform: uppercase; }
  
  .cta-container { text-align: center; margin-top: 3rem; }
</style>   
